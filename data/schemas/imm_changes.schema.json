{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Detected immigration changes (data/immigration/changes.json)",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "id",
   "route",
   "kind",
   "field",
   "previous",
   "new",
   "detected",
   "verification"
  ],
  "properties": {
   "id": {
    "type": "string"
   },
   "route": {
    "type": "string",
    "pattern": "^[A-Z]{3}-[a-z0-9-]+$"
   },
   "kind": {
    "enum": [
     "new_pathway",
     "removed_or_suspended",
     "income_requirement",
     "savings_requirement",
     "investment_requirement",
     "application_fee",
     "processing_time",
     "permanent_residency_rules",
     "citizenship_rules",
     "nationality_eligibility",
     "age_requirement",
     "dependants",
     "eligible_occupations",
     "sponsorship",
     "other",
     "education_requirement",
     "experience_requirement",
     "language_requirement"
    ]
   },
   "direction": {
    "enum": [
     "increased",
     "decreased",
     null
    ]
   },
   "field": {
    "type": [
     "string",
     "null"
    ]
   },
   "detected": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   },
   "verification": {
    "enum": [
     "pending",
     "verified",
     "rejected"
    ]
   },
   "sources": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^https://"
    }
   }
  }
 }
}