{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data version (data/version.json)",
  "type": "object",
  "properties": {
    "data_version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "data_version",
    "notes"
  ],
  "additionalProperties": false
}