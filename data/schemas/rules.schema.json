{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eligibility rules (data/rules.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocs",
    "visa_rules"
  ],
  "properties": {
    "_about": {
      "type": "string"
    },
    "blocs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "members",
          "pr_route",
          "duration",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "pr_route": {
            "enum": [
              "Yes",
              "Eventually",
              "No"
            ]
          },
          "duration": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "visa_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "visa",
          "test",
          "fail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "visa": {
            "type": "string",
            "pattern": "^[a-z_]+(\\.[a-z_]+)?$"
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "test": {
            "enum": [
              "in",
              "at_least",
              "at_most",
              "allowed",
              "flag",
              "rank_at_least",
              "language"
            ]
          },
          "ignore_zero": {
            "type": "boolean"
          },
          "only_if_eligible": {
            "type": "boolean"
          },
          "skip_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "text"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ineligible",
                  "conditional"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 5
              }
            }
          },
          "fail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "text"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ineligible",
                  "conditional"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 5
              }
            }
          },
          "scale": {
            "type": "string"
          },
          "incomparable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "text"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ineligible",
                  "conditional"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        },
        "if": {
          "properties": {
            "test": {
              "not": {
                "enum": [
                  "flag",
                  "language"
                ]
              }
            }
          }
        },
        "then": {
          "required": [
            "profile"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "test": {
                  "const": "rank_at_least"
                }
              }
            },
            "then": {
              "required": [
                "scale"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "test": {
                  "const": "language"
                }
              }
            },
            "then": {
              "required": [
                "missing",
                "incomparable"
              ]
            }
          }
        ]
      }
    },
    "scales": {
      "type": "object",
      "required": [
        "education",
        "cefr"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "uniqueItems": true
      }
    },
    "labels": {
      "type": "object",
      "properties": {
        "education": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "language": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
