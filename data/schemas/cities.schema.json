{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Major cities (data/cities.json)",
  "type": "object",
  "properties": {
    "_about": {
      "type": "string"
    },
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "object",
      "properties": {
        "temp_c": {
          "type": "string",
          "pattern": "^https://"
        },
        "price_index": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "required": [
        "temp_c"
      ],
      "additionalProperties": false
    },
    "cities": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]{3}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2
            },
            "temp_c": {
              "type": "number",
              "minimum": -30,
              "maximum": 40
            },
            "price_index": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 30,
              "maximum": 300
            }
          },
          "required": [
            "name",
            "temp_c",
            "price_index"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "_about",
    "checked",
    "sources",
    "cities"
  ],
  "additionalProperties": false
}