{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Approved immigration updates (data/immigration/updates.json)",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "route",
   "changes",
   "sources",
   "checked",
   "evidence",
   "approved_by",
   "approved"
  ],
  "properties": {
   "route": {
    "type": "string",
    "pattern": "^[A-Z]{3}-[a-z0-9-]+$"
   },
   "changes": {
    "type": "object",
    "minProperties": 1,
    "propertyNames": {
     "enum": [
      "restricted_to",
      "min_income",
      "min_investment",
      "age_min",
      "age_max",
      "requires_sponsor",
      "fields",
      "fee",
      "processing",
      "processing_weeks",
      "duration",
      "pr_route",
      "years_to_pr",
      "pr_note",
      "family",
      "difficulty"
     ]
    }
   },
   "sources": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^https://"
    },
    "minItems": 1
   },
   "checked": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   },
   "evidence": {
    "type": "string",
    "minLength": 1
   },
   "proposed_by": {
    "type": "string"
   },
   "approved_by": {
    "type": "string",
    "minLength": 1
   },
   "approved": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   }
  }
 }
}
