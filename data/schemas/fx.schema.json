{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exchange rates (data/fx.json)",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "pattern": "^https://"
    },
    "about": {
      "type": "string"
    },
    "usd_per_unit": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]{3}$"
      },
      "required": [
        "USD",
        "EUR"
      ],
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  },
  "required": [
    "date",
    "source",
    "usd_per_unit"
  ],
  "additionalProperties": false
}